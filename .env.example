# Copy to .env. No LLM key anywhere.
VAULT_DIR=./vault        # built by scripts/build_vault.py; mounted read-only at /vault
COGNEE_DATASET=obsidian_vault
POSTGRES_PASSWORD=cognee
SYNC_INTERVAL_SECONDS=0  # 0 = one sync per `compose run`; >0 = loop inside the container
SYNC_DATA_PER_BATCH=4    # documents cognified at once
SYNC_CHUNKS_PER_BATCH=4  # chunks per GLiNER call; ~250 MiB each on top of a 2.7 GiB base (README "Resources")
SYNC_MEM_LIMIT=5g          # measured peak 4.6 GiB on the 297-note vault + 8 %
SYNC_MEM_RESERVATION=3g    # model baseline + one batch
SYNC_CPUS=4                # the VM has 4; the sync is embarrassingly parallel
SYNC_LINK_EDGES=true     # write links_to edges between note documents from the connector's links column
ONTOLOGY_FILE_PATH=/app/ontology/help.owl  # closed GLiNER schema; unset for the open label bank
